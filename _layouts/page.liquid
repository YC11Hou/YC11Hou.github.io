---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

{% comment %}
  Section pages (publications, projects, news) set `i18n: <name>` and are
  translated via pages.<name>.*; project detail pages set `i18n_key` and get
  their meta line + description from proj.<key>.*. The English body is the
  source; translated bodies live in _project_l10n/<lang>/<slug>.md and are
  listed in data-l10n so i18n.js can fetch and swap the one it needs.
{% endcomment %}
{% assign l10n_docs = site.project_l10n | where: 'project', page.slug %}
<article class="page">
  <header class="page-head">
    {% if page.i18n %}
      {% if page.eyebrow %}
        <p class="eyebrow mono" data-i18n="pages.{{ page.i18n }}.eyebrow">{{ page.eyebrow }}</p>
      {% endif %}
      <h1 class="page-title" data-i18n="pages.{{ page.i18n }}.title">{{ page.title }}</h1>
      {% if page.description %}
        <p class="page-desc" data-i18n="pages.{{ page.i18n }}.desc">{{ page.description }}</p>
      {% endif %}
    {% elsif page.i18n_key %}
      {% assign project = page %}
      <p class="eyebrow mono">
        {% include project_dates.liquid class='eyebrow-dates' %}
        {% if page.meta -%}
          · <span data-i18n="proj.{{ page.i18n_key }}.meta">{{ page.meta }}</span>
        {%- endif %}
      </p>
      <h1 class="page-title">{{ page.title }}</h1>
      {% if page.description %}
        <p class="page-desc" data-i18n="proj.{{ page.i18n_key }}.desc">{{ page.description }}</p>
      {% endif %}
    {% else %}
      {% if page.eyebrow %}
        <p class="eyebrow mono">{{ page.eyebrow }}</p>
      {% elsif page.meta %}
        <p class="eyebrow mono">{{ page.meta }}</p>
      {% endif %}
      <h1 class="page-title">{{ page.title }}</h1>
      {% if page.description %}
        <p class="page-desc">{{ page.description }}</p>
      {% endif %}
    {% endif %}
  </header>

  <div
    class="prose"
    data-pagenav="{{ page.pagenav | default: 'h2' }}"
    {%- if page.i18n_key and l10n_docs.size > 0 %}
      data-l10n="{%- for d in l10n_docs -%}{{ d.lang }}:{{ d.url | relative_url }}{% unless forloop.last %};{% endunless %}{%- endfor -%}"
    {% endif %}
  >
    {{ content }}
  </div>

  {% if page.i18n_key and site.likes_api != '' %}
    <div class="likes-row" data-like-id="proj:{{ page.i18n_key }}"></div>
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</article>
