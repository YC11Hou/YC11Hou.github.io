---
layout: default
---
<article class="page">
  <header class="page-head">
    <p class="eyebrow mono">{{ page.eyebrow | default: '04 — Experience' }}</p>
    <h1 class="page-title">{{ page.title }}</h1>
    {% if page.description %}
      <p class="page-desc">{{ page.description }}</p>
    {% endif %}
  </header>

  <div class="xp">
    {% assign cv = site.data.cv.cv %}
    {% assign empty_array = '' | split: ',' %}

    {% comment %} ---------- Internship Experience ---------- {% endcomment %}
    {% assign exp = cv.sections['Internship Experience'] | default: cv.sections.Experience | default: empty_array %}
    {% assign vol = cv.sections.Volunteer | default: empty_array %}
    {% assign combined = exp | concat: vol %}
    {% if combined.size > 0 %}
      <section class="xp-section">
        <h2 class="section-label mono"><span>Internship experience</span></h2>
        {% for entry in combined %}
          {% assign sd = entry.start_date | append: '' %}
          {% assign ed = entry.end_date | append: '' %}
          {% assign sd_parts = sd | split: '-' %}
          {% if sd_parts.size == 2 %}{% assign sd = sd | append: '-01' %}{% endif %}
          {% assign ed_parts = ed | split: '-' %}
          {% if ed_parts.size == 2 %}{% assign ed = ed | append: '-01' %}{% endif %}
          {% capture start_disp %}{% if sd contains '-' %}{{ sd | date: '%b %Y' }}{% else %}{{ sd }}{% endif %}{% endcapture %}
          {% capture end_disp %}{% if ed == '' or ed == 'Present' or ed == 'present' %}Present{% elsif ed contains '-' %}{{ ed | date: '%b %Y' }}{% else %}{{ ed }}{% endif %}{% endcapture %}
          <div class="xp-entry">
            <div class="xp-when mono">
              {% if entry.date_label %}
                {{ entry.date_label }}
              {% else %}
                {{ start_disp | strip -}}
                <br>
                — {{ end_disp | strip }}
              {% endif %}
            </div>
            <div class="xp-logo">
              {% if entry.logo %}
                <img src="{{ entry.logo | prepend: '/assets/img/' | relative_url }}" alt="{{ entry.company | default: entry.name }}">
              {% else %}
                <i class="fa-solid fa-building"></i>
              {% endif %}
            </div>
            <div class="xp-body">
              <h3 class="xp-title">{{ entry.position }}</h3>
              <p class="xp-org">
                {%- if entry.url -%}
                  <a href="{{ entry.url }}">{{ entry.company | default: entry.name }}</a>
                {%- else -%}
                  {{ entry.company | default: entry.name }}
                {%- endif -%}
                {% if entry.location -%}
                  <span class="xp-loc mono">{{ entry.location }}</span>
                {%- endif %}
              </p>
              {% if entry.highlights %}
                <ul class="xp-highlights">
                  {% for item in entry.highlights %}
                    <li>{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </section>
    {% endif %}

    {% comment %} ---------- Education ---------- {% endcomment %}
    {% if cv.sections.Education.size > 0 %}
      <section class="xp-section">
        <h2 class="section-label mono"><span>Education</span></h2>
        {% for entry in cv.sections.Education %}
          {% assign sd = entry.start_date | append: '' %}
          {% assign ed = entry.end_date | append: '' %}
          {% assign sd_parts = sd | split: '-' %}
          {% if sd_parts.size == 2 %}{% assign sd = sd | append: '-01' %}{% endif %}
          {% assign ed_parts = ed | split: '-' %}
          {% if ed_parts.size == 2 %}{% assign ed = ed | append: '-01' %}{% endif %}
          {% capture start_disp %}{% if sd contains '-' %}{{ sd | date: '%b %Y' }}{% else %}{{ sd }}{% endif %}{% endcapture %}
          {% capture end_disp %}{% if ed == '' or ed == 'Present' or ed == 'present' %}Present{% elsif ed contains '-' %}{{ ed | date: '%b %Y' }}{% else %}{{ ed }}{% endif %}{% endcapture %}
          <div class="xp-entry">
            <div class="xp-when mono">
              {{ start_disp | strip -}}
              <br>
              — {{ end_disp | strip }}
            </div>
            <div class="xp-logo">
              {% if entry.logo %}
                <img src="{{ entry.logo | prepend: '/assets/img/' | relative_url }}" alt="{{ entry.institution }}">
              {% else %}
                <i class="fa-solid fa-graduation-cap"></i>
              {% endif %}
            </div>
            <div class="xp-body">
              <h3 class="xp-title">
                {{ entry.studyType | default: entry.degree -}}
                {%- if entry.area %}
                  <span class="xp-area">in {{ entry.area }}</span>
                {%- endif %}
              </h3>
              <p class="xp-org">
                {%- if entry.url -%}
                  <a href="{{ entry.url }}">{{ entry.institution }}</a>
                {%- else -%}
                  {{ entry.institution }}
                {%- endif -%}
                {% if entry.location -%}
                  <span class="xp-loc mono">{{ entry.location }}</span>
                {%- endif %}
              </p>
              {% if entry.highlights %}
                <ul class="xp-highlights">
                  {% for item in entry.highlights %}
                    <li>{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </section>
    {% endif %}
  </div>
</article>
