---
layout: default
---
{% assign t = site.data.i18n.en %}
<article class="page">
  <header class="page-head">
    <p class="eyebrow mono" data-i18n="pages.experience.eyebrow">{{ page.eyebrow | default: '04 — Experience' }}</p>
    <h1 class="page-title" data-i18n="pages.experience.title">{{ page.title }}</h1>
    {% if page.description %}
      <p class="page-desc" data-i18n="pages.experience.desc">{{ page.description }}</p>
    {% endif %}
  </header>

  <div class="xp">
    {% assign cv = site.data.cv.cv %}
    {% assign empty_array = '' | split: ',' %}

    {% comment %} ---------- Internship Experience ---------- {% endcomment %}
    {% assign exp = cv.sections['Internship Experience'] | default: cv.sections.Experience | default: empty_array %}
    {% assign vol = cv.sections.Volunteer | default: empty_array %}
    {% assign combined = exp | concat: vol %}
    {% if combined.size > 0 %}
      <section class="xp-section">
        <h2 class="section-label mono">
          <span data-i18n="pages.experience.internships">{{ t.pages.experience.internships }}</span>
        </h2>
        {% for entry in combined %}
          {% assign i = forloop.index0 %}
          {% assign sd = entry.start_date | append: '' %}
          {% assign ed = entry.end_date | append: '' %}
          {% assign sd_parts = sd | split: '-' %}
          {% if sd_parts.size == 2 %}{% assign sd = sd | append: '-01' %}{% endif %}
          {% assign ed_parts = ed | split: '-' %}
          {% if ed_parts.size == 2 %}{% assign ed = ed | append: '-01' %}{% endif %}
          {% assign is_present = false %}
          {% if ed == '' or ed == 'Present' or ed == 'present' %}{% assign is_present = true %}{% endif %}
          {% capture start_disp %}{% if sd contains '-' %}{{ sd | date: '%b %Y' }}{% else %}{{ sd }}{% endif %}{% endcapture %}
          {% capture end_disp %}{% if is_present %}Present{% elsif ed contains '-' %}{{ ed | date: '%b %Y' }}{% else %}{{ ed }}{% endif %}{% endcapture %}
          <div class="xp-entry">
            <div
              class="xp-when mono"
              data-start="{{ sd }}"
              data-end="{% if is_present %}present{% else %}{{ ed }}{% endif %}"
              {% if entry.date_label %}
                data-day
              {% endif %}
            >
              {% if entry.date_label %}
                {{ entry.date_label }}
              {% else %}
                {{ start_disp | strip -}}
                <br>
                — {{ end_disp | strip }}
              {% endif %}
            </div>
            <div class="xp-logo">
              {% if entry.logo %}
                <img src="{{ entry.logo | prepend: '/assets/img/' | relative_url }}" alt="{{ entry.company | default: entry.name }}">
              {% else %}
                <i class="fa-solid fa-building"></i>
              {% endif %}
            </div>
            <div class="xp-body">
              <h3 class="xp-title" data-i18n="xp.intern.{{ i }}.position">{{ entry.position }}</h3>
              <p class="xp-org">
                {%- if entry.url -%}
                  <a href="{{ entry.url }}">{{ entry.company | default: entry.name }}</a>
                {%- else -%}
                  {{ entry.company | default: entry.name }}
                {%- endif -%}
                {% if entry.location -%}
                  <span class="xp-loc mono" data-i18n="xp.intern.{{ i }}.location">{{ entry.location }}</span>
                {%- endif %}
              </p>
              {% if entry.highlights %}
                <ul class="xp-highlights">
                  {% for item in entry.highlights %}
                    <li data-i18n="xp.intern.{{ i }}.h.{{ forloop.index0 }}">{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </section>
    {% endif %}

    {% comment %} ---------- Education ---------- {% endcomment %}
    {% if cv.sections.Education.size > 0 %}
      <section class="xp-section">
        <h2 class="section-label mono">
          <span data-i18n="pages.experience.education">{{ t.pages.experience.education }}</span>
        </h2>
        {% for entry in cv.sections.Education %}
          {% assign i = forloop.index0 %}
          {% assign sd = entry.start_date | append: '' %}
          {% assign ed = entry.end_date | append: '' %}
          {% assign sd_parts = sd | split: '-' %}
          {% if sd_parts.size == 2 %}{% assign sd = sd | append: '-01' %}{% endif %}
          {% assign ed_parts = ed | split: '-' %}
          {% if ed_parts.size == 2 %}{% assign ed = ed | append: '-01' %}{% endif %}
          {% assign is_present = false %}
          {% if ed == '' or ed == 'Present' or ed == 'present' %}{% assign is_present = true %}{% endif %}
          {% capture start_disp %}{% if sd contains '-' %}{{ sd | date: '%b %Y' }}{% else %}{{ sd }}{% endif %}{% endcapture %}
          {% capture end_disp %}{% if is_present %}Present{% elsif ed contains '-' %}{{ ed | date: '%b %Y' }}{% else %}{{ ed }}{% endif %}{% endcapture %}
          <div class="xp-entry">
            <div class="xp-when mono" data-start="{{ sd }}" data-end="{% if is_present %}present{% else %}{{ ed }}{% endif %}">
              {{ start_disp | strip -}}
              <br>
              — {{ end_disp | strip }}
            </div>
            <div class="xp-logo">
              {% if entry.logo %}
                <img src="{{ entry.logo | prepend: '/assets/img/' | relative_url }}" alt="{{ entry.institution }}">
              {% else %}
                <i class="fa-solid fa-graduation-cap"></i>
              {% endif %}
            </div>
            <div class="xp-body">
              <h3 class="xp-title">
                <span data-i18n="xp.edu.{{ i }}.degree">{{ entry.studyType | default: entry.degree }}</span>
                {%- if entry.area %}
                  <span class="xp-area"
                    ><span data-i18n="ui.degree_in">in</span> <span data-i18n="xp.edu.{{ i }}.area">{{ entry.area }}</span></span
                  >
                {%- endif %}
              </h3>
              <p class="xp-org">
                {%- if entry.url -%}
                  <a href="{{ entry.url }}">{{ entry.institution }}</a>
                {%- else -%}
                  {{ entry.institution }}
                {%- endif -%}
                {% if entry.location -%}
                  <span class="xp-loc mono" data-i18n="xp.edu.{{ i }}.location">{{ entry.location }}</span>
                {%- endif %}
              </p>
              {% if entry.highlights %}
                <ul class="xp-highlights">
                  {% for item in entry.highlights %}
                    <li data-i18n="xp.edu.{{ i }}.h.{{ forloop.index0 }}">{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </section>
    {% endif %}
  </div>
</article>
