---
layout: default
---
{% assign t = site.data.i18n.en %}
<div class="home" data-pagenav="h2">
  <!-- Bio (three paragraphs, each its own key so translations swap cleanly) -->
  <section class="section" id="bio">
    <div class="prose lede">
      <p data-i18n="home.bio1">{{ t.home.bio1 }}</p>
      <p data-i18n="home.bio2">{{ t.home.bio2 }}</p>
      <p data-i18n="home.bio3">{{ t.home.bio3 }}</p>
    </div>
  </section>

  <!-- News -->
  {% if page.announcements and page.announcements.enabled %}
    <section class="section" id="news">
      <h2 class="section-label mono">
        <span data-i18n="home.news">{{ t.home.news }}</span
        ><a class="section-more" href="{{ '/news/' | relative_url }}" data-i18n="ui.all_news">{{ t.ui.all_news }}</a>
      </h2>
      {% include news.liquid limit=true %}
    </section>
  {% endif %}

  <!-- Selected publications -->
  {% if page.selected_papers %}
    <section class="section" id="papers">
      <h2 class="section-label mono">
        <span data-i18n="home.papers">{{ t.home.papers }}</span
        ><a class="section-more" href="{{ '/publications/' | relative_url }}" data-i18n="ui.all_publications">{{ t.ui.all_publications }}</a>
      </h2>
      {% include selected_papers.liquid %}
    </section>
  {% endif %}

  <!-- Selected work -->
  <section class="section" id="work">
    <h2 class="section-label mono">
      <span data-i18n="home.work">{{ t.home.work }}</span
      ><a class="section-more" href="{{ '/projects/' | relative_url }}" data-i18n="ui.all_projects">{{ t.ui.all_projects }}</a>
    </h2>
    <div class="work-grid">
      {% assign featured = site.projects | where: 'category', 'master' | sort: 'importance' %}
      {% for project in featured %}
        {% include project_tile.liquid %}
      {% endfor %}
    </div>
  </section>

  <!-- Closing contact line -->
  <section class="section home-contact" id="contact">
    <h2 class="section-label mono">
      <span data-i18n="home.contact">{{ t.home.contact }}</span>
    </h2>
    <p class="home-contact-line">
      <span data-i18n="home.contact_line">{{ t.home.contact_line }}</span>
      <a href="mailto:{{ site.data.socials.email }}">{{ site.data.socials.email }}</a>.
    </p>
    {% if site.likes_api != '' %}
      <div class="likes-row likes-home" data-like-id="home" data-like-notes></div>
    {% endif %}
  </section>
</div>
