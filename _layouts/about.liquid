---
layout: default
---
<div class="home">
  <!-- Opening statement -->
  <header class="home-opening">
    <p class="eyebrow mono">01 — About</p>
    <h1 class="home-title">{{ page.tagline }}</h1>
  </header>

  <!-- Scenic banner with the personal motto -->
  <figure class="home-banner">
    <img src="{{ '/assets/img/hero_castle.jpg' | relative_url }}" alt="" aria-hidden="true">
    <figcaption>
      <p class="home-quote">“The darkest hour is just before the dawn.”</p>
      <span class="home-credit mono">Neuschwanstein · photo: Thomas Wolf, CC BY-SA 3.0 DE</span>
    </figcaption>
  </figure>

  <!-- Bio -->
  <section class="section" id="bio">
    <div class="prose lede">{{ content }}</div>
  </section>

  <!-- News -->
  {% if page.announcements and page.announcements.enabled %}
    <section class="section" id="news">
      <h2 class="section-label mono"><span>02 — News</span><a class="section-more" href="{{ '/news/' | relative_url }}">All news</a></h2>
      {% include news.liquid limit=true %}
    </section>
  {% endif %}

  <!-- Selected publications -->
  {% if page.selected_papers %}
    <section class="section" id="papers">
      <h2 class="section-label mono">
        <span>03 — Selected publications</span><a class="section-more" href="{{ '/publications/' | relative_url }}">All publications</a>
      </h2>
      {% include selected_papers.liquid %}
    </section>
  {% endif %}

  <!-- Selected work -->
  <section class="section" id="work">
    <h2 class="section-label mono">
      <span>04 — Selected work</span><a class="section-more" href="{{ '/projects/' | relative_url }}">All projects</a>
    </h2>
    <div class="work-grid">
      {% assign featured = site.projects | where: 'category', 'master' | sort: 'importance' %}
      {% for project in featured %}
        {% include project_tile.liquid %}
      {% endfor %}
    </div>
  </section>

  <!-- Closing contact line -->
  <section class="section home-contact" id="contact">
    <h2 class="section-label mono"><span>05 — Contact</span></h2>
    <p class="home-contact-line">
      Open to research collaborations and PhD opportunities in embodied AI. Reach me at
      <a href="mailto:{{ site.data.socials.email }}">{{ site.data.socials.email }}</a>.
    </p>
  </section>
</div>
