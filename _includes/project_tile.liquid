{% comment %}
  Compact project tile for the home-page "Selected work" grid. Expects `project` in scope.
{% endcomment %}
{% assign project_href = project.redirect | default: project.url | relative_url %}
<a class="work-tile" href="{{ project_href }}">
  <span class="work-media">
    {% if project.preview_video %}
      <video
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        {% if project.img %}
          poster="{{ project.img | relative_url }}"
        {% endif %}
      >
        <source src="{{ project.preview_video | relative_url }}" type="video/mp4">
      </video>
    {% elsif project.img %}
      <img src="{{ project.img | relative_url }}" alt="" loading="lazy">
    {% endif %}
  </span>
  <span class="proj-head work-head">
    {% if project.venue -%}
      <span class="pub-venue">{{ project.venue }}</span>
    {%- endif %}
    {% if project.meta -%}
      <span class="work-meta mono" data-i18n="proj.{{ project.i18n_key }}.meta">{{ project.meta }}</span>
    {%- endif %}
  </span>
  <span class="work-title">{{ project.title }}</span>
  <span class="work-desc" data-i18n="proj.{{ project.i18n_key }}.desc">{{ project.description }}</span>
</a>
