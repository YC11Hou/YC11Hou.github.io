{% comment %}
  Landing page: one full-viewport screen of video (site.hero_video), the
  opening statement, motto and the four primary links, all centred. The
  navigation rail is off-canvas here and opens as an overlay from the corner
  button. Reduced-motion / data-saver / in-app browsers keep the poster only.
{% endcomment %}
{% assign t = site.data.i18n.en %}
<button type="button" class="hero-menu" aria-label="Open navigation" aria-expanded="false" title="Navigation (⌘B)">
  <i class="fa-solid fa-table-columns"></i>
</button>
<div class="rail-scrim" aria-hidden="true"></div>
<section class="home-hero" id="top">
  <div class="hero-media" aria-hidden="true" style="background-image: url('{{ site.hero_poster | relative_url }}')">
    {% if site.hero_video and site.hero_video != "" %}
      <video
        class="hero-video"
        muted
        loop
        playsinline
        preload="metadata"
        poster="{{ site.hero_poster | relative_url }}"
        data-src="{{ site.hero_video | relative_url }}"
        data-src-hd="{{ site.hero_video_hd | default: site.hero_video | relative_url }}"
        data-src-small="{{ site.hero_video_small | default: site.hero_video | relative_url }}"
      ></video>
    {% endif %}
    <div class="hero-shade"></div>
  </div>
  <div class="hero-body">
    <p class="eyebrow mono hero-eyebrow" data-i18n="ui.name">{{ t.ui.name }}</p>
    <h1 class="hero-title" data-i18n="home.tagline">{{ t.home.tagline }}</h1>
    <p class="hero-quote" data-i18n="home.quote">{{ t.home.quote }}</p>
    <nav class="hero-actions" aria-label="Primary">
      <a class="hero-btn is-primary" href="{{ '/about/' | relative_url }}" data-i18n="ui.about">{{ t.ui.about }}</a>
      <a class="hero-btn" href="{{ '/publications/' | relative_url }}" data-i18n="ui.publications">{{ t.ui.publications }}</a>
      <a class="hero-btn" href="{{ '/projects/' | relative_url }}" data-i18n="ui.projects">{{ t.ui.projects }}</a>
      <a class="hero-btn" href="{{ '/assets/pdf/CV_Yuchen_Hou.pdf' | relative_url }}" target="_blank" rel="noopener"><span data-i18n="ui.cv">{{ t.ui.cv }}</span><span>&nbsp;· PDF</span></a>
    </nav>
  </div>
  <a class="hero-scroll" href="{{ '/about/' | relative_url }}" aria-label="Continue to About">
    <span class="hero-scroll-label mono" data-i18n="ui.about">{{ t.ui.about }}</span>
    <span class="hero-scroll-line"><span></span></span>
  </a>
</section>
<script>
  (function () {
    var html = document.documentElement;
    var v = document.querySelector(".hero-video");
    if (v) {
      var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var c = navigator.connection || {};
      if (reduce || c.saveData || /MicroMessenger|QQ\//i.test(navigator.userAgent)) {
        v.remove();
      } else {
        var w = window.innerWidth, dpr = window.devicePixelRatio || 1;
        v.src = v.getAttribute(w < 900 ? "data-src-small" : (w >= 1100 && dpr >= 1.5 ? "data-src-hd" : "data-src"));
        v.muted = true;
        v.addEventListener("playing", function () { v.classList.add("is-playing"); });
        var p = v.play();
        if (p && p.catch) p.catch(function () { v.remove(); });
        document.addEventListener("visibilitychange", function () {
          if (document.hidden) v.pause(); else v.play().catch(function () {});
        });
      }
    }
    // Rail overlay: corner button, scrim, Esc and ⌘/Ctrl+B all toggle it
    var menu = document.querySelector(".hero-menu");
    var scrim = document.querySelector(".rail-scrim");
    function setRail(open) {
      html.setAttribute("data-home-rail", open ? "open" : "hidden");
      if (menu) menu.setAttribute("aria-expanded", open ? "true" : "false");
    }
    if (menu) menu.addEventListener("click", function () { setRail(html.getAttribute("data-home-rail") !== "open"); });
    if (scrim) scrim.addEventListener("click", function () { setRail(false); });
    var railBtn = document.querySelector(".rail-collapse");
    if (railBtn) railBtn.addEventListener("click", function (e) { e.stopImmediatePropagation(); setRail(false); }, true);
    // Scrolling down (wheel, swipe, keys) continues to the About page
    var aboutUrl = document.querySelector(".hero-scroll").getAttribute("href");
    var acc = 0, last = 0, leaving = false;
    function leave() {
      if (leaving) return;
      leaving = true;
      window.location.assign(aboutUrl);
    }
    window.addEventListener("wheel", function (e) {
      if (html.getAttribute("data-home-rail") === "open") return;
      var now = Date.now();
      if (now - last > 400) acc = 0;
      last = now;
      acc += e.deltaY;
      if (acc > 180) leave();
    }, { passive: true });
    var ty = null;
    window.addEventListener("touchstart", function (e) { ty = e.touches[0].clientY; }, { passive: true });
    window.addEventListener("touchmove", function (e) {
      if (ty !== null && ty - e.touches[0].clientY > 90) leave();
    }, { passive: true });
    document.addEventListener("keydown", function (e) {
      if (html.getAttribute("data-home-rail") === "open") return;
      if (e.key === "ArrowDown" || e.key === "PageDown" || (e.key === " " && !e.shiftKey)) { e.preventDefault(); leave(); }
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") setRail(false);
      if ((e.metaKey || e.ctrlKey) && !e.shiftKey && !e.altKey && e.key.toLowerCase() === "b") {
        e.preventDefault(); e.stopImmediatePropagation();
        setRail(html.getAttribute("data-home-rail") !== "open");
      }
    }, true);
  })();
</script>
