{% comment %}
  One project as a full-width editorial row: media on the left, text on the right.
  Expects `project` in scope. Used on /projects/.
{% endcomment %}
{% assign t = site.data.i18n.en %}
{% assign project_href = project.redirect | default: project.url | relative_url %}
<article class="proj-row">
  <a class="proj-media" href="{{ project_href }}" aria-label="{{ project.title }}">
    {% if project.preview_video %}
      <video
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        {% if project.img %}
          poster="{{ project.img | relative_url }}"
        {% endif %}
      >
        <source src="{{ project.preview_video | relative_url }}" type="video/mp4">
      </video>
    {% elsif project.img %}
      <img src="{{ project.img | relative_url }}" alt="" loading="lazy">
    {% endif %}
  </a>
  <div class="proj-body">
    {% if project.meta %}
      <p class="proj-meta mono" data-i18n="proj.{{ project.i18n_key }}.meta">{{ project.meta }}</p>
    {% endif %}
    <h4 class="proj-title">
      <a href="{{ project_href }}">{{ project.title }}</a>
    </h4>
    <p class="proj-desc" data-i18n="proj.{{ project.i18n_key }}.desc">{{ project.description }}</p>
    <p class="proj-links">
      <a class="proj-more" href="{{ project_href }}"
        ><span data-i18n="ui.read_more">{{ t.ui.read_more }}</span> <span aria-hidden="true">→</span></a
      >
      {% if project.github %}
        <a class="proj-code" href="{{ project.github }}" target="_blank" rel="noopener"
          ><i class="fa-brands fa-github"></i> <span data-i18n="ui.code">{{ t.ui.code }}</span></a
        >
      {% endif %}
    </p>
  </div>
</article>
