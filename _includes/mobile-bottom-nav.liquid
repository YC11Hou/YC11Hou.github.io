<!-- Mobile Bottom Navigation Bar (liquid glass) -->
<div id="mobile-bottom-nav" class="mobile-bottom-nav d-md-none">
  <!-- Nav bar with sliding glass indicator -->
  <nav class="mobile-bottom-nav-bar" role="navigation" aria-label="Mobile navigation">
    <!-- Sliding glass indicator -->
    <div class="mobile-nav-glass-indicator"></div>

    {% for page_item in site.pages %}
      {% if page_item.permalink == '/' %}
        {% assign about_title = page_item.title %}
      {% endif %}
    {% endfor %}

    <!-- About / Home -->
    <a
      href="{{ '/' | relative_url }}"
      class="mobile-bottom-nav-item {% if page.permalink == '/' %}active{% endif %}"
    >
      <i class="fa-solid fa-house"></i>
      <span>{{ about_title }}</span>
    </a>

    <!-- Other nav pages -->
    {% assign sorted_pages = site.pages | sort: 'nav_order' %}
    {% for p in sorted_pages %}
      {% if p.nav and p.autogen == null and p.dropdown == null %}
        {% assign parent_link = p.permalink | remove: 'index.html' %}
        {% if p.permalink contains '://' %}
          {% assign nav_url = p.permalink %}
        {% elsif p.permalink contains '/blog/' %}
          {% assign nav_url = '/blog/' | relative_url %}
        {% else %}
          {% assign nav_url = p.url | relative_url %}
        {% endif %}

        {% assign icon_class = 'fa-solid fa-link' %}
        {% assign title_lower = p.title | downcase %}
        {% if title_lower contains 'publication' %}
          {% assign icon_class = 'fa-solid fa-book' %}
        {% elsif title_lower contains 'project' %}
          {% assign icon_class = 'fa-solid fa-diagram-project' %}
        {% elsif title_lower contains 'cv' or title_lower contains 'resume' or title_lower contains 'experience' %}
          {% assign icon_class = 'fa-solid fa-file-lines' %}
        {% elsif title_lower contains 'blog' %}
          {% assign icon_class = 'fa-solid fa-pen-nib' %}
        {% elsif title_lower contains 'teach' %}
          {% assign icon_class = 'fa-solid fa-chalkboard-user' %}
        {% elsif title_lower contains 'people' or title_lower contains 'team' or title_lower contains 'profile' %}
          {% assign icon_class = 'fa-solid fa-users' %}
        {% endif %}

        <a
          href="{{ nav_url }}"
          class="mobile-bottom-nav-item {% if page.url contains parent_link %}active{% endif %}"
        >
          <i class="{{ icon_class }}"></i>
          <span>{{ p.title }}</span>
        </a>
      {% endif %}
    {% endfor %}

    {% if site.enable_darkmode %}
      <!-- Divider between nav items and theme toggle -->
      <div class="mobile-bottom-nav-divider"></div>

      <!-- Theme toggle (same size as nav items, inside the bar) -->
      <button
        class="mobile-bottom-nav-item mobile-bottom-nav-theme-btn"
        id="mobile-theme-toggle"
        title="Change theme"
        onclick="document.getElementById('light-toggle').click()"
      >
        <i class="fa-solid fa-circle-half-stroke"></i>
        <span>Theme</span>
      </button>
    {% endif %}
  </nav>
</div>

<script>
  // Liquid glass dock.
  // - Placed synchronously (script sits right after the markup) so the pill is
  //   in position at first paint. Arriving from a dock tap/drag on another page,
  //   it glides ONCE from the previous tab (consume-once marker; back/reload
  //   never replays).
  // - The pill is DRAGGABLE: press and slide anywhere on the dock, the glass
  //   follows your finger, snaps to the nearest tab on release and navigates.
  (function () {
    var bar = document.querySelector('.mobile-bottom-nav-bar');
    if (!bar) return;
    var indicator = bar.querySelector('.mobile-nav-glass-indicator');
    // Only real nav links carry the pill — the theme toggle is a momentary action
    var links = Array.prototype.slice.call(bar.querySelectorAll('a.mobile-bottom-nav-item'));
    var active = bar.querySelector('a.mobile-bottom-nav-item.active');
    if (!indicator || !active || !links.length) return;

    var activeIndex = links.indexOf(active);

    function place(target, animate) {
      var barRect = bar.getBoundingClientRect();
      var itemRect = target.getBoundingClientRect();
      indicator.style.transition = animate ? 'transform 0.38s cubic-bezier(0.32, 0.72, 0, 1), width 0.38s cubic-bezier(0.32, 0.72, 0, 1)' : 'none';
      indicator.style.width = itemRect.width + 'px';
      indicator.style.transform = 'translateX(' + (itemRect.left - barRect.left) + 'px)';
      indicator.style.opacity = '1';
    }

    function markHandoff(index) {
      try {
        sessionStorage.setItem('dock-from', String(index));
      } catch (e) {
        /* private mode */
      }
    }

    // ---- Arrival: consume the hand-off marker exactly once ----
    var from = null;
    try {
      from = sessionStorage.getItem('dock-from');
      sessionStorage.removeItem('dock-from');
    } catch (e) {
      /* private mode */
    }
    var fromIndex = from === null ? NaN : parseInt(from, 10);
    if (!isNaN(fromIndex) && fromIndex !== activeIndex && links[fromIndex]) {
      place(links[fromIndex], false);
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          place(active, true);
        });
      });
    } else {
      place(active, false);
    }

    // Keep the pill aligned across rotations / resizes / late font loads
    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () {
        place(active, false);
      }, 100);
    });
    window.addEventListener('load', function () {
      place(active, false);
    });

    // ---- Tap: record origin, navigate immediately ----
    links.forEach(function (item, i) {
      item.addEventListener('click', function (e) {
        if (suppressClick) {
          e.preventDefault();
          e.stopPropagation();
          return;
        }
        if (i === activeIndex) return;
        markHandoff(activeIndex);
      });
    });

    // ---- Drag: the glass follows your finger, snaps and navigates ----
    var dragging = false;
    var dragMoved = false;
    var suppressClick = false;
    var startX = 0;
    var barRect = null;
    var rects = null;

    function centers() {
      return rects.map(function (r) {
        return r.left + r.width / 2;
      });
    }

    function nearestIndex(cx) {
      var cs = centers();
      var best = 0;
      var bd = Infinity;
      for (var i = 0; i < cs.length; i++) {
        var d = Math.abs(cs[i] - cx);
        if (d < bd) {
          bd = d;
          best = i;
        }
      }
      return best;
    }

    function followFinger(clientX) {
      var cs = centers();
      var cx = Math.min(Math.max(clientX, cs[0]), cs[cs.length - 1]);
      var i = nearestIndex(cx);
      var w = rects[i].width;
      indicator.style.transition = 'width 0.18s ease';
      indicator.style.width = w + 'px';
      indicator.style.transform = 'translateX(' + (cx - barRect.left - w / 2) + 'px)';
      links.forEach(function (el, j) {
        el.classList.toggle('drag-hover', j === i);
      });
      return i;
    }

    // Links are natively draggable — that would hijack the pointer stream
    bar.addEventListener('dragstart', function (e) {
      e.preventDefault();
    });

    bar.addEventListener('pointerdown', function (e) {
      if (e.target.closest('.mobile-bottom-nav-theme-btn')) return;
      dragging = true;
      dragMoved = false;
      suppressClick = false;
      startX = e.clientX;
      barRect = bar.getBoundingClientRect();
      rects = links.map(function (el) {
        return el.getBoundingClientRect();
      });
      try {
        bar.setPointerCapture(e.pointerId);
      } catch (err) {
        /* ignore */
      }
    });

    bar.addEventListener('pointermove', function (e) {
      if (!dragging) return;
      if (!dragMoved && Math.abs(e.clientX - startX) < 8) return;
      if (!dragMoved) {
        dragMoved = true;
        indicator.classList.add('dragging');
      }
      followFinger(e.clientX);
    });

    function endDrag(e) {
      if (!dragging) return;
      dragging = false;
      if (!dragMoved) return; // plain tap — the click handler takes it
      suppressClick = true;
      setTimeout(function () {
        suppressClick = false;
      }, 350);
      indicator.classList.remove('dragging');
      links.forEach(function (el) {
        el.classList.remove('drag-hover');
      });
      var i = followFinger(e.clientX);
      place(links[i], true); // snap onto the chosen tab
      if (i !== activeIndex) {
        markHandoff(i); // pill is already there — landing page places it instantly
        var href = links[i].getAttribute('href');
        setTimeout(function () {
          window.location.href = href;
        }, 170); // let the snap read before the page turns
      }
    }

    bar.addEventListener('pointerup', endDrag);
    bar.addEventListener('pointercancel', function () {
      if (!dragging) return;
      dragging = false;
      indicator.classList.remove('dragging');
      links.forEach(function (el) {
        el.classList.remove('drag-hover');
      });
      place(active, true);
    });
  })();
</script>
