<!-- Mobile Bottom Navigation Bar (liquid glass dock) -->
<div id="mobile-bottom-nav" class="mobile-bottom-nav">
  <nav class="mobile-bottom-nav-bar" role="navigation" aria-label="Mobile navigation">
    <!--
      The selected-tab pill is a CSS pseudo-element on the `.active` item, so it is
      in the right place at first paint with zero JavaScript. This floating glass
      is only shown while the user drags across the dock.
    -->
    <div class="mobile-nav-glass-indicator" aria-hidden="true"></div>

    {% for page_item in site.pages %}
      {% if page_item.permalink == '/' %}
        {% assign about_title = page_item.title %}
      {% endif %}
    {% endfor %}

    <!-- About / Home -->
    <a
      href="{{ '/' | relative_url }}"
      class="mobile-bottom-nav-item {% if page.permalink == '/' %}active{% endif %}"
    >
      <i class="fa-solid fa-house"></i>
      <span>{{ about_title }}</span>
    </a>

    <!-- Other nav pages -->
    {% assign sorted_pages = site.pages | sort: 'nav_order' %}
    {% for p in sorted_pages %}
      {% if p.nav and p.autogen == null and p.dropdown == null %}
        {% assign parent_link = p.permalink | remove: 'index.html' %}
        {% if p.permalink contains '://' %}
          {% assign nav_url = p.permalink %}
        {% elsif p.permalink contains '/blog/' %}
          {% assign nav_url = '/blog/' | relative_url %}
        {% else %}
          {% assign nav_url = p.url | relative_url %}
        {% endif %}

        {% assign icon_class = 'fa-solid fa-link' %}
        {% assign title_lower = p.title | downcase %}
        {% if title_lower contains 'publication' %}
          {% assign icon_class = 'fa-solid fa-book' %}
        {% elsif title_lower contains 'project' %}
          {% assign icon_class = 'fa-solid fa-diagram-project' %}
        {% elsif title_lower contains 'cv' or title_lower contains 'resume' or title_lower contains 'experience' %}
          {% assign icon_class = 'fa-solid fa-file-lines' %}
        {% elsif title_lower contains 'blog' %}
          {% assign icon_class = 'fa-solid fa-pen-nib' %}
        {% elsif title_lower contains 'teach' %}
          {% assign icon_class = 'fa-solid fa-chalkboard-user' %}
        {% elsif title_lower contains 'people' or title_lower contains 'team' or title_lower contains 'profile' %}
          {% assign icon_class = 'fa-solid fa-users' %}
        {% endif %}

        <a
          href="{{ nav_url }}"
          class="mobile-bottom-nav-item {% if page.url contains parent_link %}active{% endif %}"
        >
          <i class="{{ icon_class }}"></i>
          <span>{{ p.title }}</span>
        </a>
      {% endif %}
    {% endfor %}

    {% if site.enable_darkmode %}
      <div class="mobile-bottom-nav-divider"></div>
      <button
        class="mobile-bottom-nav-item mobile-bottom-nav-theme-btn"
        id="mobile-theme-toggle"
        title="Change theme"
        onclick="document.getElementById('light-toggle').click()"
      >
        <i class="fa-solid fa-circle-half-stroke"></i>
        <span>Theme</span>
      </button>
    {% endif %}
  </nav>
</div>

<script>
  // Liquid glass dock — drag-to-select.
  //
  // The resting pill is pure CSS (`.mobile-bottom-nav-item.active::before`), so
  // nothing is measured or animated on page load: the pill is simply there.
  // Pressing and sliding on the dock lifts a floating glass blob that follows the
  // finger; on release it snaps to the nearest tab and navigates. The landing
  // page then paints its own resting pill in place — no cross-page animation.
  (function () {
    var bar = document.querySelector('.mobile-bottom-nav-bar');
    if (!bar) return;
    var glass = bar.querySelector('.mobile-nav-glass-indicator');
    var links = Array.prototype.slice.call(bar.querySelectorAll('a.mobile-bottom-nav-item'));
    var active = bar.querySelector('a.mobile-bottom-nav-item.active');
    if (!glass || !links.length) return;
    var activeIndex = links.indexOf(active);

    var dragging = false;
    var moved = false;
    var suppressClick = false;
    var pointerId = null;
    var startX = 0;
    var lastX = 0;
    var barRect = null;
    var rects = null;
    var rafPending = false;

    function centers() {
      return rects.map(function (r) {
        return r.left + r.width / 2;
      });
    }

    function nearestIndex(cx) {
      var cs = centers();
      var best = 0;
      var bd = Infinity;
      for (var i = 0; i < cs.length; i++) {
        var d = Math.abs(cs[i] - cx);
        if (d < bd) {
          bd = d;
          best = i;
        }
      }
      return best;
    }

    function setGlass(cx, width, animate) {
      glass.style.transition = animate ? 'transform 0.26s cubic-bezier(0.32, 0.72, 0, 1), width 0.26s cubic-bezier(0.32, 0.72, 0, 1)' : 'none';
      glass.style.width = width + 'px';
      glass.style.transform = 'translateX(' + (cx - barRect.left - width / 2) + 'px)';
    }

    function followFinger(clientX) {
      var cs = centers();
      var cx = Math.min(Math.max(clientX, cs[0]), cs[cs.length - 1]);
      var i = nearestIndex(cx);
      // Stretch the glass a little when travelling fast between tabs
      var stretch = 1 + Math.min(Math.abs(clientX - lastX) / 120, 0.18);
      setGlass(cx, rects[i].width * stretch, false);
      links.forEach(function (el, j) {
        el.classList.toggle('drag-hover', j === i);
      });
      return i;
    }

    function liftGlass(fromIndex) {
      var r = rects[fromIndex];
      bar.classList.add('dragging');
      glass.style.opacity = '1';
      setGlass(r.left + r.width / 2, r.width, false);
      // force a style flush so the swell animates from the resting size
      void glass.offsetWidth;
      glass.classList.add('lifted');
    }

    function dropGlass() {
      bar.classList.remove('dragging');
      glass.classList.remove('lifted');
      glass.style.opacity = '0';
      links.forEach(function (el) {
        el.classList.remove('drag-hover');
      });
    }

    function beginDrag(clientX, id) {
      dragging = true;
      moved = false;
      suppressClick = false;
      pointerId = id;
      startX = clientX;
      lastX = clientX;
      barRect = bar.getBoundingClientRect();
      rects = links.map(function (el) {
        return el.getBoundingClientRect();
      });
    }

    function moveDrag(clientX) {
      if (!dragging) return;
      if (!moved && Math.abs(clientX - startX) < 6) return;
      if (!moved) {
        moved = true;
        liftGlass(activeIndex >= 0 ? activeIndex : 0);
      }
      var x = clientX;
      if (!rafPending) {
        rafPending = true;
        requestAnimationFrame(function () {
          rafPending = false;
          if (dragging) {
            followFinger(x);
            lastX = x;
          }
        });
      }
      lastX = clientX;
    }

    function endDrag(clientX) {
      if (!dragging) return;
      dragging = false;
      pointerId = null;
      if (!moved) return; // plain tap — the link's own click handles it
      suppressClick = true;
      setTimeout(function () {
        suppressClick = false;
      }, 400);
      var i = followFinger(clientX);
      var r = rects[i];
      glass.classList.remove('lifted');
      setGlass(r.left + r.width / 2, r.width, true); // settle onto the chosen tab
      if (i === activeIndex) {
        setTimeout(dropGlass, 260);
        return;
      }
      var href = links[i].getAttribute('href');
      setTimeout(function () {
        window.location.href = href;
      }, 200); // let the settle read before the page turns
    }

    function cancelDrag() {
      if (!dragging) return;
      dragging = false;
      pointerId = null;
      dropGlass();
    }

    // Links are natively draggable — that would hijack the pointer stream
    bar.addEventListener('dragstart', function (e) {
      e.preventDefault();
    });

    links.forEach(function (item) {
      item.addEventListener('click', function (e) {
        if (suppressClick) {
          e.preventDefault();
          e.stopPropagation();
        }
      });
    });

    if (window.PointerEvent) {
      bar.addEventListener('pointerdown', function (e) {
        if (e.target.closest('.mobile-bottom-nav-theme-btn')) return;
        if (dragging) return;
        beginDrag(e.clientX, e.pointerId);
      });
      window.addEventListener('pointermove', function (e) {
        if (!dragging || e.pointerId !== pointerId) return;
        moveDrag(e.clientX);
      });
      window.addEventListener('pointerup', function (e) {
        if (!dragging || e.pointerId !== pointerId) return;
        endDrag(e.clientX);
      });
      window.addEventListener('pointercancel', function (e) {
        if (!dragging || e.pointerId !== pointerId) return;
        if (moved) {
          endDrag(lastX);
        } else {
          cancelDrag();
        }
      });
    } else {
      bar.addEventListener('touchstart', function (e) {
        if (e.target.closest('.mobile-bottom-nav-theme-btn')) return;
        beginDrag(e.touches[0].clientX, 't');
      });
      window.addEventListener(
        'touchmove',
        function (e) {
          if (!dragging) return;
          moveDrag(e.touches[0].clientX);
        },
        { passive: false }
      );
      window.addEventListener('touchend', function () {
        if (!dragging) return;
        endDrag(lastX);
      });
    }

    // While a drag is active, own the touch gesture so iOS never turns it into
    // a scroll, text selection, or link preview.
    bar.addEventListener(
      'touchmove',
      function (e) {
        if (dragging) e.preventDefault();
      },
      { passive: false }
    );
  })();
</script>
