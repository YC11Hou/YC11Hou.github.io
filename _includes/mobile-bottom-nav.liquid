<!-- Mobile Bottom Navigation Bar (liquid glass) -->
<div id="mobile-bottom-nav" class="mobile-bottom-nav d-md-none">
  <!-- Nav bar with sliding glass indicator -->
  <nav class="mobile-bottom-nav-bar" role="navigation" aria-label="Mobile navigation">
    <!-- Sliding glass indicator -->
    <div class="mobile-nav-glass-indicator"></div>

    {% for page_item in site.pages %}
      {% if page_item.permalink == '/' %}
        {% assign about_title = page_item.title %}
      {% endif %}
    {% endfor %}

    <!-- About / Home -->
    <a
      href="{{ '/' | relative_url }}"
      class="mobile-bottom-nav-item {% if page.permalink == '/' %}active{% endif %}"
    >
      <i class="fa-solid fa-house"></i>
      <span>{{ about_title }}</span>
    </a>

    <!-- Other nav pages -->
    {% assign sorted_pages = site.pages | sort: 'nav_order' %}
    {% for p in sorted_pages %}
      {% if p.nav and p.autogen == null and p.dropdown == null %}
        {% assign parent_link = p.permalink | remove: 'index.html' %}
        {% if p.permalink contains '://' %}
          {% assign nav_url = p.permalink %}
        {% elsif p.permalink contains '/blog/' %}
          {% assign nav_url = '/blog/' | relative_url %}
        {% else %}
          {% assign nav_url = p.url | relative_url %}
        {% endif %}

        {% assign icon_class = 'fa-solid fa-link' %}
        {% assign title_lower = p.title | downcase %}
        {% if title_lower contains 'publication' %}
          {% assign icon_class = 'fa-solid fa-book' %}
        {% elsif title_lower contains 'project' %}
          {% assign icon_class = 'fa-solid fa-diagram-project' %}
        {% elsif title_lower contains 'cv' or title_lower contains 'resume' or title_lower contains 'experience' %}
          {% assign icon_class = 'fa-solid fa-file-lines' %}
        {% elsif title_lower contains 'blog' %}
          {% assign icon_class = 'fa-solid fa-pen-nib' %}
        {% elsif title_lower contains 'teach' %}
          {% assign icon_class = 'fa-solid fa-chalkboard-user' %}
        {% elsif title_lower contains 'people' or title_lower contains 'team' or title_lower contains 'profile' %}
          {% assign icon_class = 'fa-solid fa-users' %}
        {% endif %}

        <a
          href="{{ nav_url }}"
          class="mobile-bottom-nav-item {% if page.url contains parent_link %}active{% endif %}"
        >
          <i class="{{ icon_class }}"></i>
          <span>{{ p.title }}</span>
        </a>
      {% endif %}
    {% endfor %}

    {% if site.enable_darkmode %}
      <!-- Divider between nav items and theme toggle -->
      <div class="mobile-bottom-nav-divider"></div>

      <!-- Theme toggle (same size as nav items, inside the bar) -->
      <button
        class="mobile-bottom-nav-item mobile-bottom-nav-theme-btn"
        id="mobile-theme-toggle"
        title="Change theme"
        onclick="document.getElementById('light-toggle').click()"
      >
        <i class="fa-solid fa-circle-half-stroke"></i>
        <span>Theme</span>
      </button>
    {% endif %}
  </nav>
</div>

<script>
  // Liquid glass active-tab pill.
  // Runs synchronously (this script sits right after the nav markup) so the pill
  // is already in place at first paint — the cross-document View Transition then
  // animates it smoothly from its position on the previous page to this one.
  (function () {
    var bar = document.querySelector('.mobile-bottom-nav-bar');
    if (!bar) return;
    var indicator = bar.querySelector('.mobile-nav-glass-indicator');
    // Only real nav links carry the pill — the theme toggle is a momentary action
    var active = bar.querySelector('a.mobile-bottom-nav-item.active');
    if (!indicator || !active) return;

    function place() {
      var barRect = bar.getBoundingClientRect();
      var itemRect = active.getBoundingClientRect();
      indicator.style.width = itemRect.width + 'px';
      indicator.style.transform = 'translateX(' + (itemRect.left - barRect.left) + 'px)';
      indicator.style.opacity = '1';
    }

    place();

    // Keep the pill aligned across rotations / resizes / late font loads
    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(place, 100);
    });
    window.addEventListener('load', place);
  })();
</script>
